<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FlashQuizz.ViewModels"
             x:Class="FlashQuizz.DeckPage"
             BackgroundColor="CadetBlue">

    <ContentPage.BindingContext>
        <local:DeckPageViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Add Flashcard" FontAttributes="Bold" HorizontalOptions="Center" />

            <Label Text="Question" FontAttributes="Bold" />
            <Entry Text="{Binding Question}" Placeholder="Enter the question" />

            <Label Text="Answer" FontAttributes="Bold" />
            <Entry Text="{Binding Answer}" Placeholder="Enter the answer" />

            <Button Text="Add Flashcard" 
                    Command="{Binding AddFlashcardCommand}" 
                    BackgroundColor="Green" 
                    TextColor="White" 
                    CornerRadius="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
