<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FlashQuizz.ViewModels"
             x:Class="FlashQuizz.AddFlashcardForm"
             BackgroundColor="White">

    <ContentPage.BindingContext>
        <local:DeckCRUDViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">
            
            <Label Text="Deck Name" FontAttributes="Bold" />
            <Entry Text="{Binding DeckName}"
                   Placeholder="Enter deck name" />

            <Label Text="Description" FontAttributes="Bold" />
            <Editor Text="{Binding Description}"
                    Placeholder="Enter description"
                    AutoSize="TextChanges"
                    HeightRequest="100" />

            <Label Text="Deck Image" FontAttributes="Bold" />
            <ImageButton Source="camera.png"
                         WidthRequest="100"
                         HeightRequest="100"
                         BackgroundColor="Transparent"
                         Command="{Binding PickImage}" />

            <Image Source="{Binding ImagePath}"
                   HeightRequest="150"
                   Aspect="AspectFit"
                   IsVisible="{Binding ImagePath, Converter={StaticResource StringToVisibilityConverter}}" />

            <Button Text="Create Deck"
                    Command="{Binding AddDeckCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
